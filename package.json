  "author": "Anuruddh Mishra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anuruddh/pixelpaw.git"
  },
  "homepage": "https://github.com/anuruddh/pixelpaw#readme",
  "bugs": {
    "url": "https://github.com/anuruddh/pixelpaw/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "pixel-art",
    "macos",
    "claude-code",
    "mcp",
    "ai-agents",
    "voice-assistant"
